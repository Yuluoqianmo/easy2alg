{
  "name": "easy2alg",
  "version": "0.1.6",
  "description": "Convert EasyEDA/LCSC footprints into Cadence Allegro libraries",
  "main": "out/main/index.js",
  "type": "module",
  "author": "Easy2ALG contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "build:ui": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@jlcpcb/core": "0.4.0",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "28.1.0",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "cn.easy2alg.app",
    "productName": "Easy2ALG",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Easy2ALG-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Easy2ALG"
    },
    "portable": {
      "artifactName": "Easy2ALG-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "Easy2ALG-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
